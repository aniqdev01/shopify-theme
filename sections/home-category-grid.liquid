<section class="home-cat-columns">
  <div class="page-width columns-grid">

    {% for block in section.blocks %}
      <div class="column" {{ block.shopify_attributes }}>

        {% if block.settings.heading != blank %}
          <h2 class="column-title">{{ block.settings.heading }}</h2>
        {% endif %}

        <div class="item-list">

          {% if block.settings.block_type == 'collection' %}
            {% assign col = collections[block.settings.collection] %}
            {% if col %}
              {% for product in col.products limit: block.settings.items_limit %}
                <a href="{{ product.url }}" class="item-card">
                  <div class="item-img">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | img_url: '160x160' }}" alt="{{ product.title }}">
                    {% endif %}
                  </div>

                  <div class="item-info">
                    <span class="item-title">{{ product.title }}</span>

                    {% if block.settings.show_price %}
                      <span class="item-price">{{ product.price | money }}</span>
                    {% endif %}
                  </div>
                </a>
              {% endfor %}
            {% endif %}
          {% else %}
            {% for i in (1..3) %}
              {% assign image_key = 'image_' | append: i %}
              {% assign title_key = 'title_' | append: i %}
              {% assign link_key  = 'link_'  | append: i %}

              {% assign img = block.settings[image_key] %}
              {% assign title = block.settings[title_key] %}
              {% assign link = block.settings[link_key] %}

              {% if title != blank %}
                <a href="{{ link }}" class="item-card">
                  <div class="item-img">
                    {% if img %}
                      <img src="{{ img | img_url: '160x160' }}" alt="{{ title }}">
                    {% endif %}
                  </div>

                  <div class="item-info">
                    <span class="item-title">{{ title }}</span>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}

        </div>

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="explore-link">
            {{ block.settings.button_text }} 
                      <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.28613 12.1426L10.5242 8.49979L7.28613 4.85693" stroke="#2F2F2F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}

      </div>
    {% endfor %}

  </div>
</section>




<style>
.home-cat-columns {
  padding: 70px 0;
  background: #F9F9F9;
}

.columns-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px;
}

/* Column title */
.column-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 24px;
    color: #121212;
}

/* List */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Card */
.item-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 16px;
  background: #fff;
  border-radius: 12px;
  text-decoration: none;
  color: inherit;
  transition: background 0.25s ease;
}

.item-card:hover {
  background: #eeeeee;
}

/* Image box */
.item-img {
  width:90px;
  height: 90px;
  {% comment %} background: #ffffff; {% endcomment %}
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-img img {
  max-width: 90px;
  max-height: 90px;
  object-fit: contain;
}

/* Text */
.item-info {
  display: flex;
  flex-direction: column;
}

.item-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #2F2F2F;
}

.item-price {
    font-size: 16px;
    font-weight: 600;
    margin-top: 2px;
    color: #2D4D86;
}

/* Explore link */
.explore-link {
display: inline-block;
    margin-top: 22px;
    font-size: 16px;
    font-weight: 600;
    color: #2F2F2F;
    text-decoration: none;
    display: flex;
    align-items: center;
}

@media screen and (max-width:750px){
.page-width.columns-grid {
    display: flex;
    flex-direction: column;
}
.home-cat-columns {
    padding: 40px 0 !important;
}
}
</style>

{% schema %}
{
  "name": "Home Category Columns",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading"
        },
        {
          "type": "select",
          "id": "block_type",
          "label": "Content type",
          "options": [
            { "value": "collection", "label": "Collection products" },
            { "value": "manual", "label": "Manual items" }
          ],
          "default": "collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (for products)"
        },
        {
          "type": "range",
          "id": "items_limit",
          "label": "Number of items",
          "min": 1,
          "max": 4,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show product price",
          "default": true
        },

        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Manual item 1 image"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Manual item 1 title"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Manual item 1 link"
        },

        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Manual item 2 image"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Manual item 2 title"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Manual item 2 link"
        },

        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Manual item 3 image"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Manual item 3 title"
        },
        {
          "type": "url",
          "id": "link_3",
          "label": "Manual item 3 link"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Explore link text",
          "default": "Explore more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Explore link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Category Columns"
    }
  ]
}
{% endschema %}
