{% style %}
.fade-hero {
  position: relative;
  width: 100%;
  min-height: 460px;
  display: flex;
  align-items: center;
  background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
  background-size: cover;
  background-position: center;
}

.fade-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  z-index: 1;
}

.fade-hero .page-width {
  position: relative;
  z-index: 2;
}

.fade-swiper {
  width: 100%;
}

.fade-slide {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  align-items: center;
  gap: 40px;
}

.fade-left h2 {
  color: {{ section.settings.heading_color }};
  /* font-size: 42px; */
    margin-bottom: 48px;
}

.fade-left p {
  color: {{ section.settings.text_color }};
  /* font-size: 18px; */
  margin-bottom: 25px;
}

.fade-buttons {
  display: flex;
  gap: 15px;
}

.fade-btn {
  padding: 12px 28px;
  border-radius: 4px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s ease;
  font-size: 16px;
}

.fade-btn.primary {
  background: {{ section.settings.primary_btn_bg }};
  color: {{ section.settings.primary_btn_text }};
      padding: 11px 76px;
}

.fade-btn.primary:hover {
  background: {{ section.settings.primary_btn_hover }};
}

.fade-btn.secondary {
  background: {{ section.settings.secondary_btn_bg }};
  color: {{ section.settings.secondary_btn_text }};
      padding: 11px 56.5px;
}

.fade-btn.secondary:hover {
  background: {{ section.settings.secondary_btn_hover }};
}

.fade-right img {
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  display:flex;
}
.mobile_btn{
    display:none;
}
@media(max-width: 900px) {
  .fade-slide {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .fade-buttons {
    justify-content: center;
            flex-direction: column;
  }
  .fade-hero .page-width{
    width:100%;
  }
  .fade-left h2 {
    font-size: 32px !important;
    margin-bottom: 0;
    letter-spacing: 0;
}
.mobile_btn{
    display:flex;
}
.desktop_btnbtn{
    display:none;
}
.fade-right img {
    max-width: 200px !important;
    height: auto;
    margin: 0 auto;
    display: flex;
    padding-bottom: 26px;
}
.fade-slide {
    gap: 17px !important;
}
}
{% endstyle %}

<div class="fade-hero">
  <div class="page-width">
    <div class="swiper fade-swiper">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="fade-slide">
            <div class="fade-left">
              <h2 class="hxl">{{ block.settings.heading }}</h2>
              <p>{{ block.settings.text }}</p>

              <div class="fade-buttons desktop_btnbtn">
                {% if block.settings.primary_label != blank %}
                <a href="{{ block.settings.primary_link }}" class="fade-btn primary">
                  {{ block.settings.primary_label }}
                </a>
                {% endif %}

                {% if block.settings.secondary_label != blank %}
                <a href="{{ block.settings.secondary_link }}" class="fade-btn secondary">
                  {{ block.settings.secondary_label }}
                </a>
                {% endif %}
              </div>
            </div>

            <div class="fade-right">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: "master" }}" alt="{{ block.settings.image }}">
              {% endif %}

                            <div class="fade-buttons mobile_btn">
                {% if block.settings.primary_label != blank %}
                <a href="{{ block.settings.primary_link }}" class="fade-btn primary">
                  {{ block.settings.primary_label }}
                </a>
                {% endif %}

                {% if block.settings.secondary_label != blank %}
                <a href="{{ block.settings.secondary_link }}" class="fade-btn secondary">
                  {{ block.settings.secondary_label }}
                </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}

      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  new Swiper(".fade-swiper", {
    effect: "fade",
    fadeEffect: {
      crossFade: true
    },
 autoplay: {
      delay: 4000,
      disableOnInteraction: false
    },   
     speed: 800, 
    loop: true
  });
});
</script>
{% schema %}
{
  "name": "Fade Hero Swiper",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Fixed Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 10
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary Button Background",
      "default": "#d71920"
    },
    {
      "type": "color",
      "id": "primary_btn_hover",
      "label": "Primary Button Hover",
      "default": "#b5141a"
    },
    {
      "type": "color",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_btn_bg",
      "label": "Secondary Button Background",
      "default": "#1f4b7f"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover",
      "label": "Secondary Button Hover",
      "default": "#16365c"
    },
    {
      "type": "color",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "We have shelves in stock"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Delivery before the New Year"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Right Side Image"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary Button Label",
          "default": "Design 3D Solution"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fade Hero Swiper"
    }
  ]
}
{% endschema %}
