<section class="solutions-section">
  <div class="page-width">

    <!-- Header -->
    <div class="solutions-header">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="view-all">
          {{ section.settings.view_all_text }} 

                    <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.28613 12.1426L10.5242 8.49979L7.28613 4.85693" stroke="#2F2F2F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
      {% endif %}
    </div>

    <!-- Grid -->
    <div class="solutions-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="solution-card">
          
          <div class="solution-image">
            {% if block.settings.image != blank %}
              <img class="cta_img_ctaa"
                src="{{ block.settings.image | img_url: "master" }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.icon != blank %}
              <span class="solution-icon">
                <img
                  src="{{ block.settings.icon | img_url: "master" }}"
                  alt="icon"
                >
              </span>
            {% endif %}
          </div>

          <h3 class="solution-title">
            {{ block.settings.title }}
          </h3>

        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>
/* =============================
   SECTION BASE
============================= */
.solutions-section {
  padding: 60px 0;
}

.solutions-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.solutions-header h2 {
  font-size: 26px;
  font-weight: 600;
  margin: 0;
}

.solutions-header .view-all {
    font-size: 16px;
    text-decoration: none;
    font-weight: 600;
    display: flex;
    align-items: center;
    color: #2f2f2f;
}

/* =============================
   GRID
============================= */
.solutions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.solution-card {
  text-decoration: none;
  color: inherit;
}

.solution-image {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
}

.solution-image img {
    width: 100%;
    height: fit-content;
    object-fit: contain;
    display: block;
}

/* =============================
   ICON
============================= */
.solution-icon {
    position: absolute;
    top: 12px;
    right: 12px;
    /* background: #fff; */
    width: 55px;
    height: 55px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    {% comment %} box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15); {% endcomment %}
}

.solution-icon img {
  width: 100%;
  height: 100%;
}

/* =============================
   TITLE
============================= */
.solution-title {
    margin-top: 10px;
    font-size: 20px;
    font-weight: 600;
    color: #2F2F2F;
}

/* =============================
   HOVER
============================= */
.solution-card:hover img {
  transform: scale(1.05);
  transition: 0.4s ease;
}

/* =============================
   MOBILE
============================= */
@media (max-width: 768px) {
  .solutions-grid {
    display: flex;
    gap: 16px;
    {% comment %} overflow-x: auto; {% endcomment %}
    padding-bottom: 10px;
    flex-wrap: wrap;
  }

  .solution-card {
    min-width: 47%;
    width:47%;
  }

  .solution-image img {
    height: 200px;
  }

  .solutions-header h2 {
    font-size: 22px;
  }
    img.cta_img_ctaa {
        object-fit: contain;
        height: fit-content;
    }
    .solution-title {
    margin-top: 10px;
    font-size: 16px !important;
    font-weight: 600;
    color: #2F2F2F;
    letter-spacing: 0;
}
.solution-image {
    position: relative;
    border-radius: 4px !important;
    overflow: hidden;
}
.solution-icon {
    position: absolute;
    top: -2px !important;
    right: -4px !important;
    /* background: #fff; */
    width: 55px;
    height: 55px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
}
</style>

{% schema %}
{
  "name": "Solutions Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Solutions"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "solution",
      "name": "Solution Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (Top Right)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Solution Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Solutions Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
