{% style %}
.text-button-bar {
  width: 100%;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_vertical }}px 20px;
}

.text-button-bar__inner {
  /* max-width: {{ section.settings.max_width }}px; */
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.text-button-bar__text {
  font-size: {{ section.settings.text_size }}px;
  color: {{ section.settings.text_color }};
  line-height: 1.4;
}

.text-button-bar__button {
  background: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text_color }};
  padding: 12px 28px;
  text-decoration: none;
  border-radius: {{ section.settings.button_radius }}px;
  font-size: {{ section.settings.button_text_size }}px;
  font-weight: 600;
  white-space: nowrap;
  transition: opacity 0.3s ease;
    width: 188px;
    text-align: center;
    border-radius: 4px;
    letter-spacing: 0;
}

.text-button-bar__button:hover {
  opacity: 0.85;
}

@media (max-width: 768px) {
  .text-button-bar__inner {
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 0;
  }
  a.text-button-bar__button {
    width: 100%;
    text-align: center;
}
}
{% endstyle %}

<section class="text-button-bar">
  <div class="text-button-bar__inner page-width">
    
    {% if section.settings.text != blank %}
      <div class="text-button-bar__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="text-button-bar__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Text with Button Bar",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur gravida."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#d60000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button Text Size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "Text with Button Bar"
    }
  ]
}
{% endschema %}