{% style %}
.trusted-by-section {
  padding: 40px 0;
}

.trusted-by-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.trusted-by-header h2 {
  margin: 0;
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
}

.trusted-by-header a {
font-size: 16px;
    text-decoration: none;
    font-weight: 600;
    display: flex;
    align-items: center;
  color: {{ section.settings.link_color }};
}

.trusted-logos {
  display: flex;
  gap: 40px;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
}

.trusted-logo img {
  max-height: {{ section.settings.logo_height }}px;
  width: auto;
  opacity: 0.9;
}

@media (max-width: 768px) {
  .trusted-logos {
gap: 49px;
        justify-content: flex-start;
        flex-wrap: unset;
        overflow: auto;
  }

  .trusted-by-header {
flex-direction: row;
        gap: 10px;
        align-items: center;
  }
  .trusted-by-section {

    padding-bottom: 20px;
}
}
{% endstyle %}

<div class="trusted-by-section">
  <div class="page-width">

    <div class="trusted-by-header">
      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}">
          {{ section.settings.link_text }} 
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.28613 12.1426L10.5242 8.49979L7.28613 4.85693" stroke="#2F2F2F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

        </a>
      {% endif %}
    </div>

    <div class="trusted-logos">
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}
          <div class="trusted-logo" {{ block.shopify_attributes }}>
            <img
              src="{{ block.settings.logo | img_url:"master" }}"
              alt="{{ block.settings.alt_text }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Trusted By Logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Trusted By"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Right Link Text",
      "default": "See more"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Right Link URL"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 30,
      "max": 120,
      "step": 5,
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand Logo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trusted By"
    }
  ]
}
{% endschema %}
