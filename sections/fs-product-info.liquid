<section class="product-tabs-wrapper">
  <div class="page-width">

    <!-- Tabs -->
    <ul class="tabs-nav">
      <li class="tab-link active" data-tab="tab-desc">{{ section.settings.tab1_title }}</li>
      <li class="tab-link" data-tab="tab-info">{{ section.settings.tab2_title }}</li>
      <li class="tab-link" data-tab="tab-doc">{{ section.settings.tab3_title }}</li>
      <li class="tab-link" data-tab="tab-review">{{ section.settings.tab4_title }}</li>
    </ul>

    <!-- Description -->
    <div id="tab-desc" class="tab-content active">
      <div class="desc-grid">

        <!-- TEXT -->
        <div class="desc-text">
          {{ section.settings.description }}
        </div>

        <!-- IMAGE -->
        {% if section.settings.desc_image != blank %}
        <div class="desc-image">
          <img 
            src="{{ section.settings.desc_image | img_url: 'master' }}" 
            alt="Description Image"
            loading="lazy"
          >
        </div>
        {% endif %}

      </div>
    </div>

    <!-- Additional Info -->
    <div id="tab-info" class="tab-content">
      <div class="info-table-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'info' %}
          <div class="info-row">
            <div class="info-label">{{ block.settings.label }}</div>
            <div class="info-value">{{ block.settings.value }}</div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Documentation -->
    <div id="tab-doc" class="tab-content">
      <div class="docs-grid">
        {% for block in section.blocks %}
          {% if block.type == 'doc' %}
          <a href="{{ block.settings.file }}" class="doc-box" download>

            <!-- PDF ICON -->
            <span class="pdf-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M14 2v6h6" stroke="currentColor" stroke-width="1.5"/>
                <text x="7" y="17" font-size="6" fill="currentColor">PDF</text>
              </svg>
            </span>

            <span class="doc-title">
              {{ block.settings.title }}
            </span>

            <!-- DOWNLOAD ICON -->
            <span class="download-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M12 3v12" stroke="currentColor" stroke-width="1.5"/>
                <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M4 20h16" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>

          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Reviews -->
    <div id="tab-review" class="tab-content">

      <div class="review-summary">
        ⭐ {{ section.settings.rating }} / 5
        <small>{{ section.settings.total_reviews }} Reviews</small>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'review' %}
        <div class="single-review">
          <strong>{{ block.settings.name }}</strong>
          <small>{{ block.settings.date }}</small>
          <p>{{ block.settings.review_text }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.product-tabs-wrapper {padding:40px 0}

.tabs-nav{
  display:flex;
  border-bottom:1px solid #ddd;
}
.tabs-nav li{list-style:none}

.tab-link{
  padding:12px 20px;
  cursor:pointer;
  font-weight:600;
}
.tab-link.active{
  border-bottom:2px solid #000;
}

.tab-content{display:none;padding:25px 0}
.tab-content.active{display:block}

/* DESCRIPTION */
.desc-grid{
  display:grid;
  grid-template-columns: 1.3fr 1fr;
  gap:40px;
}
.desc-text{
  font-size:14px;
  line-height:1.7;
}
.desc-image img{
  width:100%;
  border-radius:8px;
  box-shadow:0 4px 12px rgba(0,0,0,.08);
}

/* INFO */
.info-table-wrapper{
  border:1px solid #ddd;
  border-radius:8px;
  overflow:hidden;
}
.info-row{
  display:flex;
  justify-content:space-between;
  padding:16px 24px;
  border-bottom:1px solid #eee;
}
.info-row:nth-child(even){background:#fafafa}

/* DOCS */
.docs-grid{display:flex;gap:15px}
.doc-box{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:14px 18px;
  border:1px solid #e5e5e5;
  text-decoration:none;
  color:#000;
}
.doc-box:hover{background:#f8f8f8}
.doc-title{flex:1;font-weight:500}

/* REVIEWS */
.single-review{
  border-bottom:1px solid #eee;
  padding:15px 0;
}

/* MOBILE */
@media(max-width:768px){
  .desc-grid{grid-template-columns:1fr}
}
</style>

<script>
document.querySelectorAll('.tab-link').forEach(tab=>{
  tab.addEventListener('click',()=>{
    document.querySelectorAll('.tab-link').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));

    tab.classList.add('active');
    document.getElementById(tab.dataset.tab).classList.add('active');
  });
});
</script>

{% schema %}
{
  "name": "Product Tabs Custom",
  "settings": [
    {
      "type": "text",
      "id": "tab1_title",
      "label": "Tab 1 Title",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Content"
    },
    {
      "type": "image_picker",
      "id": "desc_image",
      "label": "Description Image"
    },
    {
      "type": "text",
      "id": "tab2_title",
      "label": "Tab 2 Title",
      "default": "Additional information"
    },
    {
      "type": "text",
      "id": "tab3_title",
      "label": "Tab 3 Title",
      "default": "Documentation"
    },
    {
      "type": "text",
      "id": "tab4_title",
      "label": "Tab 4 Title",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.5"
    },
    {
      "type": "text",
      "id": "total_reviews",
      "label": "Total Reviews",
      "default": "5"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Additional Info Row",
      "settings": [
        {"type":"text","id":"label","label":"Label"},
        {"type":"text","id":"value","label":"Value"}
      ]
    },
    {
      "type": "doc",
      "name": "Document",
      "settings": [
        {"type":"text","id":"title","label":"Document Title"},
        {"type":"url","id":"file","label":"File URL"}
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"text","id":"name","label":"Customer Name"},
        {"type":"text","id":"date","label":"Date"},
        {"type":"textarea","id":"review_text","label":"Review Text"}
      ]
    }
  ],
  "presets": [
    {"name": "Product Tabs Custom"}
  ]
}
{% endschema %}
