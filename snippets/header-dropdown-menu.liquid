{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">

{% style %}
.custom-toggle-menu {
    width: fit-content;
        position: relative;
}
nav.header__inline-menu {
    display: flex;
    align-items: center;
}

.custom-toggle-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  cursor: pointer;
  user-select: none;
  background: {{ settings.bg_color }};
  color: {{ settings.text_color }};
  font-size: {{ settings.text_size }}px;
  font-weight: 600;
      width: 248px;
    position: relative;
    height: 45px;
    border-radius: 0;
    border-top-right-radius: 8px;
    border-top-left-radius: 8px;
}

.custom-toggle-btn svg {
  width: 18px;
  height: 18px;
  fill: {{ settings.icon_color }};
}

.custom-menu-content {
  display: none;
  margin-top: 10px;
  background: {{ settings.menu_bg }};
  border-radius: {{ settings.radius }}px;
  overflow: hidden;
}

.custom-menu-content.active {
  display: block;
}

.custom-menu-content ul {
  list-style: none;
  margin: 0;
  padding: 0;
  width: 248px;
}

.custom-menu-content li a {
  display: block;
  padding: 12px 16px;
  color: {{ settings.menu_text_color }};
  text-decoration: none;
}

.custom-menu-content li a:hover {
  background: {{ settings.menu_hover_bg }};
}
.custom-menu-content.active {
    position: absolute;
        margin-top: 0;
}
{% endstyle %}

<div class="custom-toggle-menu" data-section-id="{{ section.id }}">
  
  <div class="custom-toggle-btn" id="toggleBtn-{{ section.id }}">
    
    {% if settings.show_icon %}
<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M2 3.3335H2.00667M2 8.00016H2.00667M2 12.6668H2.00667M5.33333 3.3335H14M5.33333 8.00016H14M5.33333 12.6668H14" stroke="#F9F9F9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

    {% endif %}

    <span>{{ settings.button_text }}</span>
  </div>

  <div class="custom-menu-content" id="menuContent-{{ section.id }}">
    {% if section.settings.menu != blank %}
      <ul>
        {% for link in linklists[settings.menu].links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const wrapper = document.querySelector(
    '.custom-toggle-menu[data-section-id="sections--19590151209132__header_Wn8MJQ"]'
  );

  const menu = wrapper.querySelector('.custom-menu-content');

  wrapper.addEventListener('mouseenter', function () {
    menu.classList.add('active');
  });

  wrapper.addEventListener('mouseleave', function () {
    menu.classList.remove('active');
  });
});
</script>
<style>
  .custom-menu-content {
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.3s ease;
}

.custom-menu-content.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

</style>
{% comment %} <script>
document.addEventListener('DOMContentLoaded', function () {
  const btn = document.getElementById('toggleBtn-{{ section.id }}');
  const menu = document.getElementById('menuContent-{{ section.id }}');

  btn.addEventListener('click', function () {
    menu.classList.toggle('active');
  });
});
</script> {% endcomment %}


  <ul class="list-menu list-menu--inline" role="list">


        {% assign showB2BNav = false %}
              
        {%- if showB2BNav == true -%}

          {%- if customer.metafields.sparklayer.authentication -%}
            {% assign menu = linklists.b2b-menu | default: linklists[section.settings.menu] %}
          {%- else -%}
            {% assign menu = linklists[section.settings.menu] %}
          {%- endif -%}

        {%- else -%}

          {% assign menu = linklists[section.settings.menu] %}

        {%- endif -%}


    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
